# ==========================================
# Handball Tracker - Beispiel-Konfiguration
# Kopieren nach ".env" und Werte anpassen.
# setup_pi.sh erzeugt die .env automatisch mit gefuellten Secrets.
# ==========================================

# --- Server ---

# Port des Webservers
PORT=3000

# Auf welchen Netzwerk-Schnittstellen gelauscht wird.
#   127.0.0.1  nur lokal - richtig hinter dem Cloudflare-Tunnel
#   0.0.0.0    auch im Heimnetz erreichbar (z.B. zum Testen per LAN-IP)
HOST=127.0.0.1

# Wo die Spieldaten liegen. BEWUSST ausserhalb des Projektordners, damit
# ein "git pull" oder ein Neuaufsetzen die Daten nicht mitreisst.
# Leer lassen = ./data im Projektordner (nur fuer lokale Entwicklung).
DATA_DIR=/var/lib/handball-tracker

# --- Login / Sicherheit ---

# Secret zum Signieren der Login-Tokens.
# PFLICHT im Produktivbetrieb, mindestens 32 Zeichen.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Fehlt der Wert, erzeugt der Server einmalig ein zufaelliges Secret
# und legt es unter DATA_DIR/.jwt_secret ab.
JWT_SECRET=

# Einladungscode fuer die Registrierung.
# Ist der Wert gesetzt, kann sich niemand mehr ohne diesen Code anmelden.
# Leer lassen = oeffentliche Registrierung (nicht empfohlen).
REGISTRATION_CODE=

# --- WhatsApp-Ticker (derzeit deaktiviert) ---

# Auf true setzen, um den Bot zu aktivieren. Aus spart 200-400 MB RAM
# auf dem Pi, weil Chromium gar nicht erst startet.
WHATSAPP_ENABLED=false

# Passwort fuer die Bot-Steuerung (Status, QR, Logout, Senden)
ADMIN_PASSWORD=

# Ziel-Gruppe fuer den Live-Ticker.
# Die ID wird beim ersten Start nach dem QR-Scan in der Konsole ausgegeben.
TARGET_GROUP_ID=

# Pfad zum Chromium-Binary fuer den Bot.
#   Raspberry Pi OS (Bookworm):  /usr/bin/chromium
#   Aeltere Images / Ubuntu:     /usr/bin/chromium-browser
# Ermitteln mit:  which chromium || which chromium-browser
CHROMIUM_PATH=/usr/bin/chromium
