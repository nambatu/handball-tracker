# ==========================================
# Handball Tracker - Beispiel-Konfiguration
# Kopieren nach ".env" und Werte anpassen.
# setup_pi.sh erzeugt die .env automatisch mit gefuellten Secrets.
# ==========================================

# --- Server ---

# Port des Webservers
PORT=3000

# Auf welchen Netzwerk-Schnittstellen gelauscht wird.
#   127.0.0.1  nur lokal - richtig hinter dem Cloudflare-Tunnel
#   0.0.0.0    auch im Heimnetz erreichbar (z.B. zum Testen per LAN-IP)
HOST=127.0.0.1

# Wo die Spieldaten liegen. BEWUSST ausserhalb des Projektordners, damit
# ein "git pull" oder ein Neuaufsetzen die Daten nicht mitreisst.
# Leer lassen = ./data im Projektordner (nur fuer lokale Entwicklung).
DATA_DIR=/var/lib/handball-tracker

# --- Login / Sicherheit ---

# Secret zum Signieren der Login-Tokens.
# PFLICHT im Produktivbetrieb, mindestens 32 Zeichen.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Fehlt der Wert, erzeugt der Server einmalig ein zufaelliges Secret
# und legt es unter DATA_DIR/.jwt_secret ab.
JWT_SECRET=

# Einladungscode fuer die Registrierung.
# Ist der Wert gesetzt, kann sich niemand mehr ohne diesen Code anmelden.
# Leer lassen = oeffentliche Registrierung (nicht empfohlen).
REGISTRATION_CODE=

# --- WhatsApp-Ticker ---

# Die WhatsApp-Sitzung liegt NICHT mehr hier, sondern im eigenen Dienst
# wa-gateway: eine gekoppelte Nummer und ein Chromium fuer Tracker und
# handball.net-Bot zusammen. Hier bleibt nur die Outbox, aus der das
# Gateway per Long-Poll abholt.
#
# Warum es abholt statt angerufen zu werden: der Pi haengt hinter CGNAT
# und nimmt keine eingehenden Verbindungen an. Steht der Tracker spaeter
# auf einem VPS, koennte er das Gateway gar nicht erreichen.

# Token, mit dem sich das Gateway an der Outbox anmeldet. MUSS mit
# OUTBOX_TRACKER_TOKEN in der wa-gateway/.env uebereinstimmen.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKER_TOKEN=

# Wie alt eine Aktion hoechstens sein darf, um noch getickert zu werden.
# Aelteres wird stumm verworfen - ein Ticker, der nach der Halbzeitpause
# dreissig Nachrichten nachschiebt, hilft niemandem.
TICKER_MAX_ALTER_MS=120000

# Nur fuer die Gruppenauswahl in der Oberflaeche. Der Nachrichtenweg
# braucht das NICHT: ohne diese Werte laesst sich die Gruppen-ID im
# Ticker-Fenster von Hand eintragen. Auf dem VPS bleibt das leer, weil
# das Gateway hinter CGNAT nicht erreichbar ist.
GATEWAY_URL=http://127.0.0.1:3100
GATEWAY_TOKEN=
GATEWAY_SESSION=default

# --- KI-Analyse zum Spielende (optional) ---

# Ohne Schluessel passiert einfach nichts - die Zahlen-Zusammenfassung
# kommt trotzdem. Die Analyse ist eine ZWEITE Nachricht und laeuft
# nachtraeglich; ein ueberlastetes Modell haelt den Ticker nicht auf.
# Schluessel: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Starkes Modell zuerst, schnelles als Rueckfall - wie im handball.net-Bot.
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_MODEL_FALLBACK=gemini-3-flash-preview
GEMINI_TIMEOUT_MS=25000
